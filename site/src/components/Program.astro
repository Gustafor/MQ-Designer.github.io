---
import Accordion from "./Accordion.astro";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import { modules } from "../data/course";
---

<section class="section program" id="program">
  <div class="container program__grid">
    <aside class="program__aside">
      <div class="program__intro">
        <span class="eyebrow">Программа</span>
        <h2 class="h2">От первой схемы до защиты топологии</h2>
        <p class="lead">
          {modules.length} модулей, 47 часов практики и один сквозной проект.
          Каждый модуль заканчивается артефактом, а не тестом.
        </p>
      </div>

      <div class="program__stats">
        <div><span class="mono">Формат</span><strong>2 занятия в неделю</strong></div>
        <div><span class="mono">Практика</span><strong>12 заданий</strong></div>
        <div><span class="mono">Проект</span><strong>1 capstone</strong></div>
        <div><span class="mono">Записи</span><strong>12 месяцев</strong></div>
      </div>

      <div class="program__download">
        <span class="program__download-icon"><Icon name="book" size={22} /></span>
        <div>
          <strong>Программа в PDF</strong>
          <span>С темами, артефактами и критериями защиты</span>
        </div>
        <Button href="#lead" variant="secondary" full icon>Скачать PDF</Button>
      </div>

      <p class="program__note">
        Программа может меняться: добавляем разборы после каждого потока. Ссылка на актуальную версию — в личном кабинете.
      </p>
    </aside>

    <div class="program__content">
      <div class="program__content-head">
        <span class="mono">module map / {modules.length} modules</span>
        <span class="program__status"><i></i> обновлено для потока №1</span>
      </div>
      <Accordion items={modules} />
      <div class="program__bottom">
        <span><Icon name="check" size={14} /> В каждом модуле — практика в среде</span>
        <a href="#lead">Получить полную программу <Icon name="arrow-right" size={14} /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .program__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }

  .program__aside {
    position: sticky;
    top: 100px;
  }

  .program__intro .h2 {
    max-width: 460px;
  }

  .program__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    margin-top: 26px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--border);
    overflow: hidden;
  }

  .program__stats div {
    display: grid;
    gap: 5px;
    padding: 13px 15px;
    background: var(--surface);
  }

  .program__stats span {
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .program__stats strong {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
  }

  .program__download {
    display: grid;
    gap: 13px;
    margin-top: 20px;
    padding: 18px;
    border: 1px solid rgba(255, 85, 51, 0.36);
    border-radius: var(--radius);
    background: var(--accent-soft);
  }

  .program__download-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(255, 85, 51, 0.36);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--accent-ink);
  }

  .program__download div {
    display: grid;
    gap: 4px;
  }

  .program__download strong {
    font-size: 16px;
    font-weight: 600;
  }

  .program__download span {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.4;
  }

  .program__note {
    margin-top: 14px;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.45;
  }

  .program__content-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 12px;
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .program__status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--green);
    font-family: var(--mono);
    font-size: 8px;
    white-space: nowrap;
  }

  .program__status i {
    width: 5px;
    height: 5px;
    border-radius: 1px;
    background: var(--green);
  }

  .program__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 20px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-deep);
    color: var(--muted);
    font-size: 12px;
  }

  .program__bottom span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .program__bottom svg {
    color: var(--accent-ink);
  }

  .program__bottom a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent-ink);
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .program__bottom a:hover {
    color: var(--text);
  }

  @media (max-width: 1023px) {
    .program__grid {
      grid-template-columns: 1fr;
    }

    .program__aside {
      position: static;
    }

    .program__intro .h2 {
      max-width: 760px;
    }

    .program__stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .program__download {
      grid-template-columns: auto 1fr auto;
      align-items: center;
    }

    .program__download :global(.btn) {
      width: auto;
    }
  }

  @media (max-width: 767px) {
    .program__stats {
      grid-template-columns: 1fr 1fr;
    }

    .program__download {
      grid-template-columns: 1fr;
    }

    .program__bottom {
      display: grid;
    }

    .program__bottom a {
      justify-self: start;
    }

    .program__content-head {
      display: grid;
      gap: 8px;
    }
  }
</style>
