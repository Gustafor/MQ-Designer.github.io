---
import Icon from "./Icon.astro";
import type { IconName } from "../data/course";

interface Item {
  number?: string;
  title: string;
  hours?: string;
  summary?: string;
  artifact?: string;
  tags?: string[];
}

interface Props {
  items: Item[];
  openFirst?: boolean;
  name?: string;
}

const { items, openFirst = true, name = "accordion" } = Astro.props;
---

<div class="accordion">
  {items.map((item, index) => (
    <details class="accordion__item" name={name} open={openFirst && index === 0}>
      <summary class="accordion__summary">
        <span class="accordion__number mono">{item.number ?? String(index + 1).padStart(2, "0")}</span>
        <span class="accordion__title">{item.title}</span>
        {item.hours && <span class="accordion__hours mono">{item.hours}</span>}
        <span class="accordion__chevron"><Icon name="chevron-down" size={18} /></span>
      </summary>
      <div class="accordion__body">
        {item.summary && <p>{item.summary}</p>}
        {item.tags && item.tags.length > 0 && (
          <div class="accordion__tags">
            {item.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        )}
        {item.artifact && (
          <div class="accordion__artifact">
            <Icon name="arrow-right" size={14} />
            <span><strong>Артефакт:</strong> {item.artifact}</span>
          </div>
        )}
      </div>
    </details>
  ))}
</div>

<style>
  .accordion {
    border-top: 1px solid var(--border);
  }

  .accordion__item {
    border-bottom: 1px solid var(--border);
  }

  .accordion__summary {
    display: grid;
    grid-template-columns: 42px 1fr auto 28px;
    gap: 14px;
    align-items: center;
    min-height: 82px;
    padding: 14px 0;
    cursor: pointer;
    list-style: none;
  }

  .accordion__summary::-webkit-details-marker {
    display: none;
  }

  .accordion__summary:hover .accordion__title {
    color: var(--accent-ink);
  }

  .accordion__number {
    color: var(--accent-ink);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  .accordion__title {
    font-size: clamp(18px, 1.7vw, 22px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    transition: color 160ms ease;
  }

  .accordion__hours {
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .accordion__chevron {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--muted);
    transition:
      transform 180ms ease,
      color 180ms ease,
      border-color 180ms ease;
  }

  .accordion__item[open] .accordion__chevron {
    transform: rotate(180deg);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .accordion__body {
    padding: 0 42px 24px 56px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }

  .accordion__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }

  .accordion__artifact {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    color: var(--text);
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.4;
  }

  .accordion__artifact svg {
    flex: 0 0 auto;
    color: var(--accent-ink);
  }

  @media (max-width: 767px) {
    .accordion__summary {
      grid-template-columns: 28px 1fr 26px;
      gap: 10px;
      min-height: 64px;
    }

    .accordion__hours {
      display: none;
    }

    .accordion__body {
      padding: 0 0 22px 38px;
    }
  }
</style>
