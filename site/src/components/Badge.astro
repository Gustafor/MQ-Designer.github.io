---
interface Props {
  variant?: "accent" | "muted" | "outline" | "yellow";
  class?: string;
}

const { variant = "outline", class: className = "" } = Astro.props;
---

<span class:list={["badge", `badge--${variant}`, className]}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 25px;
    padding: 4px 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .badge--accent {
    border-color: rgba(255, 85, 51, 0.4);
    background: var(--accent-soft);
    color: var(--accent-ink);
  }

  .badge--muted {
    color: var(--muted);
  }

  .badge--outline {
    color: var(--text);
  }

  .badge--yellow {
    border-color: rgba(138, 101, 0, 0.35);
    background: #fbf4dd;
    color: var(--yellow);
  }

  .badge::before {
    width: 5px;
    height: 5px;
    border-radius: 1px;
    background: currentColor;
    content: "";
  }
</style>
