---
import Icon from "./Icon.astro";
import LeadForm from "./LeadForm.astro";
import { site } from "../data/course";
---

<section class="section lead-section" id="lead">
  <div class="container lead-section__grid">
    <div class="lead-section__copy">
      <span class="eyebrow">Заявка</span>
      <h2 class="h2">Получите программу и разбор первого кейса</h2>
      <p class="lead">
        Пришлём PDF с модулями, артефактами и критериями защиты. Если захотите — созвонимся на 15 минут и проверим, подходит ли курс.
      </p>

      <ul class="lead-section__list">
        <li><Icon name="check" size={15} /><span><strong>Программа в PDF</strong> — 9 модулей без воды</span></li>
        <li><Icon name="check" size={15} /><span><strong>Чек-лист топологии</strong> — 24 вопроса для ревью</span></li>
        <li><Icon name="check" size={15} /><span><strong>Запись разбора</strong> — как падает потребитель и что с этим делать</span></li>
      </ul>

      <div class="lead-section__contact">
        <span class="mono">Есть вопрос?</span>
        <a href={site.telegram} target="_blank" rel="noopener noreferrer"><Icon name="telegram" size={16} /> Telegram</a>
        <a href={`mailto:${site.email}`}><Icon name="mail" size={15} /> {site.email}</a>
      </div>

      <p class="lead-section__disclaimer">
        Нажимая «Получить программу», вы соглашаетесь с политикой обработки данных. Не передаём контакты третьим лицам.
      </p>
    </div>

    <div class="lead-section__form" data-reveal>
      <LeadForm />
    </div>
  </div>
</section>

<style>
  .lead-section {
    background:
      linear-gradient(90deg, transparent 49.9%, var(--grid-line) 50%, transparent 50.1%),
      var(--bg);
  }

  .lead-section__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }

  .lead-section__copy .h2 {
    max-width: 600px;
  }

  .lead-section__list {
    display: grid;
    gap: 12px;
    margin-top: 26px;
    font-size: 14px;
    line-height: 1.4;
  }

  .lead-section__list li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    color: var(--muted);
  }

  .lead-section__list svg {
    flex: 0 0 auto;
    margin-top: 2px;
    color: var(--accent-ink);
  }

  .lead-section__list strong {
    color: var(--text);
    font-weight: 600;
  }

  .lead-section__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }

  .lead-section__contact > span {
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .lead-section__contact a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text);
    font-size: 12px;
    font-weight: 600;
  }

  .lead-section__contact a:hover {
    color: var(--accent-ink);
  }

  .lead-section__disclaimer {
    max-width: 480px;
    margin-top: 22px;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.5;
  }

  .lead-section__form {
    min-width: 0;
  }

  @media (max-width: 900px) {
    .lead-section__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
