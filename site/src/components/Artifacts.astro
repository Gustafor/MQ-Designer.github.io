---
import Icon from "./Icon.astro";
import SectionHeader from "./SectionHeader.astro";
import { artifacts } from "../data/course";
---

<section class="section artifacts" id="artifacts">
  <div class="container">
    <SectionHeader
      kicker="Артефакты"
      title="После курса остаётся не конспект, а рабочий комплект"
      lead="Всё можно показать на ревью, приложить к резюме или забрать в свой проект. Без «сертификата за просмотр видео»."
      aside="Каждый артефакт появляется в результате практики и проверяется по критериям."
    />

    <div class="artifacts__grid">
      {artifacts.map((artifact, index) => (
        <article class="artifacts__card" data-reveal style={`transition-delay: ${index * 60}ms`}>
          <div class="artifacts__top">
            <span class="artifacts__icon"><Icon name={artifact.icon} size={23} /></span>
            <span class="artifacts__meta mono">{artifact.meta}</span>
          </div>
          <h3>{artifact.title}</h3>
          <p>{artifact.text}</p>
          <span class="artifacts__line"></span>
        </article>
      ))}
    </div>

    <div class="artifacts__preview" data-reveal>
      <div class="artifacts__preview-head">
        <span class="mono">пример / definitions.json</span>
        <span class="artifacts__preview-badge"><Icon name="check" size={11} /> валидный экспорт</span>
      </div>
      <pre><code>&#123;
  <span class="code-key">"rabbit_version"</span>: <span class="code-str">"3.13"</span>,
  <span class="code-key">"exchanges"</span>: [&#123;
    <span class="code-key">"name"</span>: <span class="code-str">"orders.events"</span>,
    <span class="code-key">"vhost"</span>: <span class="code-str">"/"</span>,
    <span class="code-key">"type"</span>: <span class="code-str">"topic"</span>,
    <span class="code-key">"durable"</span>: <span class="code-bool">true</span>
  &#125;],
  <span class="code-key">"queues"</span>: [&#123;
    <span class="code-key">"name"</span>: <span class="code-str">"orders.email"</span>,
    <span class="code-key">"arguments"</span>: &#123; <span class="code-key">"x-queue-type"</span>: <span class="code-str">"quorum"</span> &#125;
  &#125;]
&#125;</code></pre>
      <div class="artifacts__preview-foot">
        <span>Экспорт из среды → импорт в RabbitMQ</span>
        <span class="mono">rabbitmqctl import_definitions</span>
      </div>
    </div>
  </div>
</section>

<style>
  .artifacts__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .artifacts__card {
    position: relative;
    min-height: 234px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }

  .artifacts__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 32px;
  }

  .artifacts__icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(255, 85, 51, 0.3);
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--accent-ink);
  }

  .artifacts__meta {
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 0.06em;
  }

  .artifacts__card h3 {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .artifacts__card p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
  }

  .artifacts__line {
    position: absolute;
    right: 20px;
    bottom: 17px;
    left: 20px;
    height: 1px;
    background: var(--border);
  }

  .artifacts__preview {
    margin-top: 16px;
    padding: 16px 20px;
    border: 1px solid var(--terminal);
    border-radius: var(--radius);
    background: var(--terminal);
  }

  .artifacts__preview-head,
  .artifacts__preview-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--terminal-muted);
    font-size: 9px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .artifacts__preview-head {
    padding-bottom: 12px;
    border-bottom: 1px solid var(--terminal-border);
  }

  .artifacts__preview-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #a9d18e;
  }

  .artifacts__preview pre {
    overflow-x: auto;
    margin: 14px 0;
    color: #b7b0a8;
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.6;
  }

  .artifacts__preview-foot {
    padding-top: 12px;
    border-top: 1px solid var(--terminal-border);
    text-transform: none;
  }

  .artifacts__preview-foot .mono {
    color: var(--terminal-muted);
    font-size: 9px;
  }

  .code-key {
    color: #ff9d88;
  }

  .code-str {
    color: #b8d99a;
  }

  .code-bool {
    color: #e8c86a;
  }

  @media (max-width: 1023px) {
    .artifacts__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .artifacts__grid {
      grid-template-columns: 1fr;
    }

    .artifacts__card {
      min-height: 0;
    }

    .artifacts__line {
      display: none;
    }

    .artifacts__preview {
      display: none;
    }
  }
</style>
