---
import Icon from "./Icon.astro";
import { nav, site } from "../data/course";
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="footer__logo" href="/#top" aria-label="RabbitMQ Designer — наверх">
          <span class="footer__mark" aria-hidden="true">//</span>
          <span><strong>RabbitMQ</strong><small>Designer</small></span>
        </a>
        <p>Курс по RabbitMQ и визуальная среда для проектирования топологий. Практика, симуляция, артефакты.</p>
        <div class="footer__social">
          <a href={site.githubUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub"><Icon name="github" size={17} /></a>
          <a href={site.telegram} target="_blank" rel="noopener noreferrer" aria-label="Telegram"><Icon name="telegram" size={17} /></a>
          <a href={`mailto:${site.email}`} aria-label="Email"><Icon name="mail" size={16} /></a>
        </div>
      </div>

      <div class="footer__col">
        <span class="footer__title mono">Курс</span>
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="/#lead">Заявка</a>
      </div>

      <div class="footer__col">
        <span class="footer__title mono">Материалы</span>
        <a href="/program/">Программа</a>
        <a href="/#artifacts">Артефакты</a>
        <a href="/tools/">О среде</a>
        <a href={site.appUrl} target="_blank" rel="noopener noreferrer">Открыть среду</a>
        <a href="/free/">Бесплатные материалы</a>
      </div>

      <div class="footer__col">
        <span class="footer__title mono">Документы</span>
        <a href="/legal/privacy/">Политика ПДн</a>
        <a href="/legal/offer/">Оферта</a>
        <a href="/corporate/">Для компаний</a>
        <a href="/ui/">UI-кит</a>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© {year} RabbitMQ Designer. Прототип, не является публичной офертой.</span>
      <span class="mono">made for engineers / RU</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 64px 0 26px;
    border-top: 1px solid var(--border);
    background: var(--bg-deep);
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) repeat(3, minmax(0, 0.65fr));
    gap: 32px;
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .footer__mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--terminal);
    font-family: var(--mono);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.18em;
  }

  .footer__logo span:last-child {
    display: grid;
    gap: 1px;
    font-size: 14px;
    line-height: 1.05;
  }

  .footer__logo small {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer__brand p {
    max-width: 340px;
    margin-top: 18px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
  }

  .footer__social {
    display: flex;
    gap: 8px;
    margin-top: 18px;
  }

  .footer__social a {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--muted);
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .footer__social a:hover {
    border-color: var(--text);
    background: var(--surface);
    color: var(--accent-ink);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 9px;
    padding-top: 4px;
  }

  .footer__title {
    margin-bottom: 3px;
    color: var(--accent-ink);
    font-size: 9px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .footer__col a {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.35;
    transition: color 160ms ease;
  }

  .footer__col a:hover {
    color: var(--text);
  }

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 48px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 10px;
    line-height: 1.4;
  }

  .footer__bottom .mono {
    font-size: 9px;
    letter-spacing: 0.04em;
  }

  @media (max-width: 900px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 767px) {
    .footer {
      padding-top: 36px;
      padding-bottom: 26px;
    }

    .footer__top {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .footer__bottom {
      display: grid;
      gap: 8px;
      margin-top: 24px;
    }
  }
</style>
