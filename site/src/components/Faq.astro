---
import Icon from "./Icon.astro";
import { faqs } from "../data/course";
---

<section class="section section--deep faq" id="faq">
  <div class="container faq__grid">
    <div class="faq__aside">
      <span class="eyebrow">FAQ</span>
      <h2 class="h2">Коротко о важном</h2>
      <p class="lead">Если ответа нет — напишите в Telegram. Отвечает команда курса, не бот.</p>
      <a class="faq__link" href="#lead">Задать вопрос <Icon name="arrow-right" size={14} /></a>
    </div>

    <div class="faq__list">
      {faqs.map((item, index) => (
        <details class="faq__item" name="faq" open={index === 0}>
          <summary>
            <span>{item.q}</span>
            <span class="faq__icon"><Icon name="chevron-down" size={17} /></span>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.38fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }

  .faq__aside {
    position: sticky;
    top: 100px;
  }

  .faq__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 24px;
    color: var(--accent-ink);
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .faq__link:hover {
    color: var(--text);
  }

  .faq__list {
    border-top: 1px solid var(--border);
  }

  .faq__item {
    border-bottom: 1px solid var(--border);
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    min-height: 68px;
    padding: 12px 0;
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary > span:first-child {
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .faq__icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 28px;
    height: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--muted);
    transition:
      transform 180ms ease,
      color 180ms ease,
      border-color 180ms ease;
  }

  .faq__item[open] .faq__icon {
    transform: rotate(180deg);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .faq__item p {
    max-width: 680px;
    padding: 0 44px 20px 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.55;
  }

  @media (max-width: 1023px) {
    .faq__grid {
      grid-template-columns: 1fr;
    }

    .faq__aside {
      position: static;
    }
  }

  @media (max-width: 767px) {
    .faq__item summary {
      min-height: 56px;
    }

    .faq__item summary > span:first-child {
      font-size: 15px;
    }

    .faq__item p {
      padding-right: 0;
      padding-bottom: 16px;
      font-size: 13px;
    }
  }
</style>
