---
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import { nav, site } from "../data/course";
---

<div class="announce">
  <div class="container announce__inner">
    <span class="announce__dot"></span>
    <span>{site.cohort} · старт {site.startDate} · осталось {site.seats}</span>
    <a href="/#pricing">Смотреть тарифы <Icon name="arrow-right" size={13} /></a>
  </div>
</div>

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="logo" href="#top" aria-label="RabbitMQ Designer — на главную">
      <span class="logo__mark" aria-hidden="true">//</span>
      <span class="logo__text">
        <strong>RabbitMQ</strong>
        <span>Designer</span>
      </span>
    </a>

    <nav class="nav" id="main-nav" aria-label="Основная навигация">
      {nav.map((item) => (
        <a class="nav__link" href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="site-header__actions">
      <a class="site-header__app" href={site.appUrl} target="_blank" rel="noopener noreferrer">
        Открыть среду <Icon name="arrow-up-right" size={15} />
      </a>
      <Button href="/#pricing" variant="primary" class="header-cta">Записаться</Button>
      <button
        class="menu-toggle"
        type="button"
        aria-label="Открыть меню"
        aria-controls="main-nav"
        aria-expanded="false"
        data-menu-toggle
      >
        <span class="menu-toggle__open"><Icon name="menu" size={22} /></span>
        <span class="menu-toggle__close"><Icon name="close" size={22} /></span>
      </button>
    </div>
  </div>

  <div class="mobile-panel" data-mobile-panel>
    <nav class="mobile-panel__nav" aria-label="Мобильная навигация">
      {nav.map((item) => (
        <a href={item.href} data-mobile-link>{item.label}</a>
      ))}
      <a href={site.appUrl} target="_blank" rel="noopener noreferrer">
        Открыть среду <Icon name="arrow-up-right" size={16} />
      </a>
    </nav>
    <Button href="/#pricing" variant="primary" full>Записаться на курс</Button>
  </div>
</header>

<style>
  .announce {
    border-bottom: 1px solid var(--terminal-border);
    background: var(--terminal);
    color: var(--terminal-muted);
  }

  .announce__inner {
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 34px;
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .announce__dot {
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: var(--accent);
  }

  .announce a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
    border-bottom: 1px solid rgba(246, 242, 237, 0.28);
    color: var(--terminal-text);
    font-weight: 600;
  }

  .announce a :global(svg) {
    color: var(--accent);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    border-bottom: 1px solid transparent;
    background: rgba(251, 250, 248, 0.86);
    backdrop-filter: blur(14px);
    transition:
      background-color 180ms ease,
      border-color 180ms ease;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--border);
    background: rgba(251, 250, 248, 0.97);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 32px;
    min-height: 74px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex: 0 0 auto;
  }

  .logo__mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--terminal);
    font-family: var(--mono);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.18em;
    line-height: 1;
  }

  .logo__text {
    display: grid;
    gap: 1px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .logo__text span {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav__link {
    position: relative;
    padding: 27px 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color 160ms ease;
  }

  .nav__link::after {
    position: absolute;
    right: 0;
    bottom: 19px;
    left: 0;
    height: 1px;
    background: var(--accent);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease;
  }

  .nav__link:hover,
  .nav__link.is-active {
    color: var(--text);
  }

  .nav__link:hover::after,
  .nav__link.is-active::after {
    transform: scaleX(1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-left: auto;
  }

  .site-header__app {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 160ms ease;
  }

  .site-header__app:hover {
    color: var(--accent-ink);
  }

  .site-header__app :global(svg) {
    color: var(--accent);
  }

  .menu-toggle {
    display: none;
    place-items: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid var(--text);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text);
  }

  .menu-toggle__close {
    display: none;
  }

  .site-header[data-open] .menu-toggle__open {
    display: none;
  }

  .site-header[data-open] .menu-toggle__close {
    display: block;
  }

  .mobile-panel {
    display: none;
  }

  @media (max-width: 1080px) {
    .nav {
      gap: 16px;
    }

    .nav__link {
      font-size: 9px;
    }

    .site-header__app {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .site-header__inner {
      min-height: 66px;
    }

    .nav {
      display: none;
    }

    .site-header__actions {
      gap: 10px;
    }

    .site-header__actions :global(.header-cta) {
      display: none;
    }

    .menu-toggle {
      display: grid;
    }

    .mobile-panel {
      display: none;
      padding: 8px 16px 22px;
      border-top: 1px solid var(--border);
      background: var(--bg);
    }

    .site-header[data-open] .mobile-panel {
      display: block;
      animation: menu-in 180ms var(--ease);
    }

    .mobile-panel__nav {
      display: grid;
      gap: 2px;
      margin-bottom: 18px;
    }

    .mobile-panel__nav a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 48px;
      border-bottom: 1px solid var(--border);
      color: var(--text);
      font-family: var(--mono);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .mobile-panel__nav a:last-child {
      border-bottom: 0;
      color: var(--accent-ink);
    }
  }

  @media (max-width: 767px) {
    .announce__inner {
      min-height: 32px;
      font-size: 8px;
    }

    .announce a {
      display: none;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-5px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header[data-open] .mobile-panel {
      animation: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");

  const closeMenu = () => {
    if (!header || !toggle) return;
    header.removeAttribute("data-open");
    toggle.setAttribute("aria-expanded", "false");
    toggle.setAttribute("aria-label", "Открыть меню");
    document.body.classList.remove("nav-open");
  };

  toggle?.addEventListener("click", () => {
    if (!header || !toggle) return;
    const open = header.hasAttribute("data-open");
    if (open) {
      closeMenu();
      return;
    }
    header.setAttribute("data-open", "");
    toggle.setAttribute("aria-expanded", "true");
    toggle.setAttribute("aria-label", "Закрыть меню");
    document.body.classList.add("nav-open");
  });

  document.querySelectorAll("[data-mobile-link], .mobile-panel a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });

  const onScroll = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 12);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const links = [...document.querySelectorAll<HTMLAnchorElement>(".nav__link")];
  const sections = links
    .map((link) => {
      const id = link.getAttribute("href");
      return id ? document.querySelector<HTMLElement>(id) : null;
    })
    .filter((section): section is HTMLElement => Boolean(section));

  if (sections.length > 0 && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((link) => {
            link.classList.toggle("is-active", link.getAttribute("href") === `#${entry.target.id}`);
          });
        });
      },
      { rootMargin: "-30% 0px -55% 0px", threshold: 0.01 },
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>
