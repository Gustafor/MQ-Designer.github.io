---
import Badge from "./Badge.astro";
import Button from "./Button.astro";
import FeatureTile from "./FeatureTile.astro";
import Icon from "./Icon.astro";
import { facts, site } from "../data/course";
---

<section class="hero" id="top">
  <div class="hero__bg" aria-hidden="true">
    <span class="hero__ring"></span>
    <span class="hero__line hero__line--one"></span>
    <span class="hero__line hero__line--two"></span>
  </div>

  <div class="container hero__grid">
    <div class="hero__copy">
      <div class="hero__meta">
        <Badge variant="accent">Курс + среда</Badge>
        <Badge variant="muted">Java / Spring</Badge>
        <Badge variant="muted">Поток №1</Badge>
      </div>

      <h1 class="hero__title">
        Проектируйте <span class="accent">RabbitMQ-топологии</span>, которые не теряют сообщения
      </h1>

      <p class="hero__lead">
        6 недель практики в визуальной среде: от routing и DLQ до Spring AMQP
        и защиты проекта. Без магии в конфигах и «так исторически сложилось».
      </p>

      <a class="hero__mobile-proof" href={site.appUrl} target="_blank" rel="noopener noreferrer">
        <span class="hero__mobile-thumb">
          <img src="/screenshots/designer.png" alt="Скриншот RabbitMQ Designer" width="72" height="48" loading="eager" />
        </span>
        <span>
          <strong>Среда RabbitMQ Designer</strong>
          <small>live-симуляция · definitions.json</small>
        </span>
        <Icon name="arrow-up-right" size={15} />
      </a>

      <ul class="hero__bullets">
        <li><Icon name="check" size={15} /> Собираете схему мышью и сразу видите маршрут каждого сообщения</li>
        <li><Icon name="check" size={15} /> Получаете definitions.json, Java-конфиг и документ для ревью</li>
        <li><Icon name="check" size={15} /> Автор — создатель среды RabbitMQ Designer</li>
      </ul>

      <div class="hero__actions">
        <Button href="#pricing" size="lg" icon>Записаться на курс</Button>
        <Button href="#program" variant="secondary" size="lg">Смотреть программу</Button>
      </div>

      <div class="hero__micro">
        <span><Icon name="calendar" size={14} /> Старт {site.startDate}</span>
        <span><Icon name="clock" size={14} /> 6 недель</span>
        <span><Icon name="user" size={14} /> {site.seats}</span>
      </div>

      <div class="hero__author">
        <img src="/images/author.svg" alt="Gustafor — автор курса" width="44" height="44" />
        <div>
          <span>Автор курса</span>
          <strong>Gustafor</strong>
        </div>
        <a href={site.githubUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub автора">
          <Icon name="github" size={18} />
        </a>
      </div>
    </div>

    <div class="hero__visual" data-reveal>
      <div class="hero__frame">
        <div class="hero__frame-bar">
          <span class="hero__dots"><i></i><i></i><i></i></span>
          <span class="hero__url mono">rabbitmq-designer / live simulation</span>
          <span class="hero__live"><i></i> online</span>
        </div>
        <div class="hero__screen">
          <img
            src="/screenshots/designer.png"
            alt="Интерфейс RabbitMQ Designer: топология, очереди и журнал сообщений"
            width="1425"
            height="1185"
            loading="eager"
          />
        </div>
        <div class="hero__frame-stamp mono">FIG. 01 / LIVE ENVIRONMENT</div>
      </div>

      <div class="hero__route mono">
        <span>order.created</span>
        <Icon name="arrow-right" size={14} />
        <span class="hero__route-accent">DLQ</span>
      </div>

      <div class="hero__code">
        <div class="hero__code-head">
          <span class="mono">definitions.json</span>
          <span class="hero__code-dot"></span>
        </div>
        <pre><code><span class="code-key">"exchanges"</span>: [&#123;
  <span class="code-key">"name"</span>: <span class="code-str">"orders.events"</span>,
  <span class="code-key">"type"</span>: <span class="code-str">"topic"</span>
&#125;],
<span class="code-key">"queues"</span>: [&#123;
  <span class="code-key">"name"</span>: <span class="code-str">"orders.email"</span>,
  <span class="code-key">"arguments"</span>: &#123;
    <span class="code-key">"x-queue-type"</span>: <span class="code-str">"quorum"</span>
  &#125;
&#125;]</code></pre>
        <div class="hero__code-foot">
          <Icon name="check" size={12} /> импортируется в RabbitMQ
        </div>
      </div>

      <div class="hero__proof">
        <span class="hero__proof-avatar">
          <img src="/images/author.svg" alt="" width="34" height="34" />
        </span>
        <span><strong>Среда в браузере.</strong> Ничего не нужно устанавливать.</span>
      </div>
    </div>
  </div>

  <div class="container hero__facts-wrap" data-reveal>
    <div class="hero__facts-head">
      <span class="fig-label">FIG. 02 / COURSE PARAMETERS</span>
      <span class="mono">6 weeks / 1 stream</span>
    </div>
    <div class="hero__facts">
      {facts.map((fact) => <FeatureTile {...fact} />)}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 64px 0 48px;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(90deg, #000 0%, #000 60%, transparent 94%);
    opacity: 0.68;
    pointer-events: none;
  }

  .hero__ring {
    position: absolute;
    top: 82px;
    right: -172px;
    width: 560px;
    height: 560px;
    border: 1px solid var(--border);
    border-radius: 0;
  }

  .hero__ring::after {
    position: absolute;
    inset: 38px;
    border: 1px dashed var(--border);
    border-radius: 0;
    content: "";
  }

  .hero__line {
    position: absolute;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .hero__line--one {
    top: 238px;
    left: 0;
    width: 100%;
    height: 1px;
  }

  .hero__line--two {
    top: 0;
    left: 62%;
    width: 1px;
    height: 100%;
    background: linear-gradient(180deg, transparent, var(--border), transparent);
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr);
    gap: clamp(36px, 5vw, 74px);
    align-items: center;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .hero__title {
    max-width: 760px;
    margin-top: 22px;
    font-family: var(--font-display);
    font-size: clamp(40px, 4.5vw, 58px);
    font-weight: 700;
    letter-spacing: -0.052em;
    line-height: 1;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .hero__title span {
    display: inline;
    color: var(--accent);
  }

  .hero__lead {
    max-width: 640px;
    margin-top: 22px;
    color: var(--muted);
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.52;
  }

  .hero__mobile-proof {
    display: none;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    padding: 7px 9px 7px 7px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .hero__mobile-thumb {
    flex: 0 0 auto;
    width: 72px;
    height: 48px;
    overflow: hidden;
    border: 1px solid var(--terminal-border);
    border-radius: 1px;
    background: var(--terminal);
  }

  .hero__mobile-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 10%;
  }

  .hero__mobile-proof > span:nth-child(2) {
    display: grid;
    gap: 2px;
    line-height: 1.2;
  }

  .hero__mobile-proof strong {
    font-size: 11px;
    font-weight: 600;
  }

  .hero__mobile-proof small {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 8px;
  }

  .hero__mobile-proof > svg {
    flex: 0 0 auto;
    margin-left: auto;
    color: var(--accent-ink);
  }

  .hero__bullets {
    display: grid;
    gap: 9px;
    margin-top: 23px;
    color: var(--text);
    font-size: 13.5px;
    line-height: 1.42;
  }

  .hero__bullets li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
  }

  .hero__bullets svg {
    flex: 0 0 auto;
    margin-top: 2px;
    color: var(--accent-ink);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 28px;
  }

  .hero__micro {
    display: flex;
    flex-wrap: wrap;
    gap: 9px 18px;
    margin-top: 17px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero__micro span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .hero__micro svg {
    color: var(--accent-ink);
  }

  .hero__author {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    padding: 7px 11px 7px 7px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .hero__author img {
    width: 36px;
    height: 36px;
    border-radius: 1px;
    image-rendering: pixelated;
    object-fit: cover;
  }

  .hero__author div {
    display: grid;
    gap: 1px;
    padding-right: 8px;
    line-height: 1.1;
  }

  .hero__author span {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero__author strong {
    font-size: 13px;
    font-weight: 600;
  }

  .hero__author a {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-left: 1px solid var(--border);
    color: var(--muted);
    transition: color 160ms ease;
  }

  .hero__author a:hover {
    color: var(--accent-ink);
  }

  .hero__visual {
    position: relative;
    min-width: 0;
    padding: 18px 0 86px;
  }

  .hero__frame {
    position: relative;
    z-index: 1;
    overflow: hidden;
    border: 1px solid var(--terminal);
    border-radius: var(--radius);
    background: var(--terminal);
    box-shadow: 10px 10px 0 var(--border);
  }

  .hero__frame-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 38px;
    padding: 0 13px;
    border-bottom: 1px solid var(--terminal-border);
    background: var(--terminal-2);
    color: var(--terminal-muted);
    font-size: 8px;
  }

  .hero__dots {
    display: flex;
    gap: 5px;
    flex: 0 0 auto;
  }

  .hero__dots i {
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: #4d4742;
  }

  .hero__dots i:first-child {
    background: var(--accent);
  }

  .hero__url {
    overflow: hidden;
    max-width: 220px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hero__live {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-left: auto;
    color: #a9d18e;
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero__live i {
    width: 5px;
    height: 5px;
    border-radius: 1px;
    background: #a9d18e;
    box-shadow: 0 0 0 3px rgba(169, 209, 142, 0.12);
  }

  .hero__screen {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1.22;
    background: #12110f;
  }

  .hero__screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 8%;
    filter: saturate(0.88) contrast(1.03);
  }

  .hero__screen::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 64%, rgba(16, 15, 13, 0.34));
    content: "";
    pointer-events: none;
  }

  .hero__frame-stamp {
    position: absolute;
    right: 13px;
    bottom: 11px;
    padding: 4px 7px;
    border: 1px solid rgba(246, 242, 237, 0.2);
    border-radius: 1px;
    background: rgba(23, 22, 20, 0.78);
    color: #c5bdb5;
    font-size: 7px;
    letter-spacing: 0.08em;
  }

  .hero__route {
    position: absolute;
    top: 0;
    right: 16px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 9px;
    border: 1px solid var(--text);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--muted);
    font-size: 8px;
    letter-spacing: -0.02em;
    box-shadow: 3px 3px 0 var(--accent-soft);
  }

  .hero__route svg {
    color: var(--accent-ink);
  }

  .hero__route-accent {
    color: var(--accent-ink);
    font-weight: 600;
  }

  .hero__code {
    position: absolute;
    bottom: 0;
    left: -18px;
    z-index: 3;
    width: min(330px, 82%);
    padding: 12px;
    border: 1px solid var(--terminal-border);
    border-radius: var(--radius);
    background: var(--terminal-2);
    box-shadow: 6px 6px 0 var(--border);
  }

  .hero__code-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--terminal-border);
    color: var(--terminal-muted);
    font-size: 8px;
  }

  .hero__code-dot {
    width: 5px;
    height: 5px;
    border-radius: 1px;
    background: #a9d18e;
  }

  .hero__code pre {
    overflow: hidden;
    margin: 9px 0 8px;
    color: #b7b0a8;
    font-family: var(--mono);
    font-size: 8px;
    line-height: 1.55;
    white-space: pre;
  }

  .code-key {
    color: #ff9d88;
  }

  .code-str {
    color: #b8d99a;
  }

  .hero__code-foot {
    display: flex;
    align-items: center;
    gap: 5px;
    padding-top: 8px;
    border-top: 1px solid var(--terminal-border);
    color: #a9d18e;
    font-family: var(--mono);
    font-size: 7.5px;
  }

  .hero__code-foot::after {
    width: 5px;
    height: 9px;
    margin-left: 2px;
    background: var(--terminal-accent);
    content: "";
    animation: caret 1.15s steps(1) infinite;
  }

  .hero__proof {
    position: absolute;
    right: -8px;
    bottom: 18px;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 210px;
    padding: 7px 9px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--muted);
    font-size: 10px;
    line-height: 1.35;
    box-shadow: 3px 3px 0 var(--accent-soft);
  }

  .hero__proof strong {
    color: var(--text);
    font-weight: 600;
  }

  .hero__proof-avatar {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 30px;
    height: 30px;
    padding: 1px;
    border: 1px solid var(--border);
    border-radius: 1px;
    background: var(--surface-2);
  }

  .hero__proof-avatar img {
    width: 100%;
    height: 100%;
    border-radius: 1px;
    image-rendering: pixelated;
    object-fit: cover;
  }

  .hero__facts-wrap {
    position: relative;
    z-index: 1;
    margin-top: 50px;
  }

  .hero__facts-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 10px;
    padding-bottom: 9px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-size: 8px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero__facts {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 8px;
  }

  @keyframes caret {
    0%,
    48% {
      opacity: 1;
    }
    49%,
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 1180px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      gap: 36px;
    }

    .hero__facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .hero__proof {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: 46px;
    }

    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__title {
      max-width: 820px;
      font-size: clamp(38px, 7vw, 54px);
    }

    .hero__mobile-proof {
      display: flex;
    }

    .hero__bullets li:nth-child(3) {
      display: none;
    }

    .hero__visual {
      max-width: 720px;
      margin-top: 28px;
      padding-bottom: 82px;
    }

    .hero__facts-wrap {
      margin-top: 36px;
    }

    .hero__facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .hero {
      padding: 32px 0 28px;
    }

    .hero__title {
      margin-top: 17px;
      font-size: clamp(34px, 10vw, 46px);
      line-height: 0.99;
    }

    .hero__lead {
      margin-top: 17px;
      font-size: 15px;
    }

    .hero__bullets {
      margin-top: 19px;
      font-size: 13px;
    }

    .hero__actions {
      display: grid;
      grid-template-columns: 1fr;
      margin-top: 23px;
    }

    .hero__micro {
      gap: 8px 12px;
      font-size: 8px;
    }

    .hero__author {
      margin-top: 21px;
    }

    .hero__visual {
      margin-top: 30px;
      padding-bottom: 0;
    }

    .hero__frame {
      box-shadow: 6px 6px 0 var(--border);
    }

    .hero__route {
      top: -11px;
      right: 4px;
    }

    .hero__code {
      display: none;
    }

    .hero__proof {
      display: none;
    }

    .hero__facts-wrap {
      margin-top: 30px;
    }

    .hero__facts-head > span:last-child {
      display: none;
    }

    .hero__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__code-foot::after {
      display: none;
    }
  }
</style>
