---
interface Props {
  kicker?: string;
  title: string;
  lead?: string;
  aside?: string;
  align?: "left" | "center";
  class?: string;
}

const { kicker, title, lead, aside, align = "left", class: className = "" } = Astro.props;
---

<header class:list={["section-head", align === "center" && "section-head--center", className]}>
  <div class="section-head__copy">
    {kicker && <span class="eyebrow">{kicker}</span>}
    <h2 class="h2" set:html={title} />
    {lead && <p class="lead">{lead}</p>}
  </div>
  {aside && <p class="section-head__aside">{aside}</p>}
</header>

<style>
  .section-head--center {
    display: block;
    text-align: center;
  }

  .section-head--center .section-head__copy {
    margin-inline: auto;
  }

  .section-head--center .h2,
  .section-head--center .lead {
    margin-inline: auto;
  }
</style>
