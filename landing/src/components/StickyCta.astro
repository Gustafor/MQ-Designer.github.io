---
import Icon from "./Icon.astro";
---

<div class="sticky-cta" data-sticky-cta aria-label="Быстрые действия">
  <a class="sticky-cta__secondary" href="/#program">Программа</a>
  <a class="sticky-cta__primary" href="/#pricing">
    Записаться <Icon name="arrow-right" size={16} />
  </a>
</div>

<style>
  .sticky-cta {
    display: none;
  }

  @media (max-width: 767px) {
    .sticky-cta {
      position: fixed;
      right: 12px;
      bottom: 12px;
      left: 12px;
      z-index: 50;
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      gap: 6px;
      padding: 6px;
      border: 1px solid var(--text);
      border-radius: var(--radius);
      background: rgba(251, 250, 248, 0.96);
      backdrop-filter: blur(12px);
      box-shadow: 4px 4px 0 rgba(29, 27, 26, 0.12);
      opacity: 0;
      pointer-events: none;
      transform: translateY(calc(100% + 24px));
      transition:
        opacity 200ms ease,
        transform 200ms var(--ease);
    }

    .sticky-cta.is-visible {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }

    :global(body.nav-open) .sticky-cta {
      opacity: 0;
      pointer-events: none;
    }

    .sticky-cta a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      min-height: 44px;
      border-radius: var(--radius-sm);
      font-family: var(--mono);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.07em;
      text-transform: uppercase;
    }

    .sticky-cta__secondary {
      border: 1px solid var(--border-strong);
      color: var(--text);
    }

    .sticky-cta__primary {
      background: var(--terminal);
      color: var(--terminal-text);
    }

    .sticky-cta__primary :global(svg) {
      color: var(--accent);
    }
  }
</style>

<script>
  const sticky = document.querySelector<HTMLElement>("[data-sticky-cta]");
  const footer = document.querySelector<HTMLElement>(".footer");

  if (sticky) {
    const update = () => {
      const hasScrolled = window.scrollY > Math.max(520, window.innerHeight * 0.7);
      const footerVisible = footer ? footer.getBoundingClientRect().top < window.innerHeight - 12 : false;
      sticky.classList.toggle("is-visible", hasScrolled && !footerVisible);
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }
</script>
