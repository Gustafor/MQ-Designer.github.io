---
import Badge from "./Badge.astro";
import Icon from "./Icon.astro";
import PricingCard from "./PricingCard.astro";
import SectionHeader from "./SectionHeader.astro";
import { plans } from "../data/course";
---

<section class="section section--deep pricing" id="pricing">
  <div class="container">
    <SectionHeader
      kicker="Стоимость"
      title="Три способа пройти курс"
      lead="Можно учиться самостоятельно, с проверкой или привести команду. Везде есть среда, практика и доступ к записям."
      aside="Оплата через ЮKassa. Для компаний — счёт, договор и закрывающие документы."
    />

    <div class="pricing__grid">
      {plans.map((plan) => <PricingCard plan={plan} />)}
    </div>

    <div class="pricing__footer">
      <div class="pricing__guarantee">
        <span class="pricing__guarantee-icon"><Icon name="shield" size={18} /></span>
        <span><strong>14 дней на возврат.</strong> Если пройдено меньше 20% курса — вернём оплату.</span>
      </div>
      <div class="pricing__payment">
        <Badge variant="muted">ЮKassa</Badge>
        <Badge variant="muted">Счёт для компании</Badge>
        <Badge variant="muted">Рассрочка</Badge>
      </div>
    </div>

    <div class="pricing__help">
      <span class="mono">Не знаете, что выбрать?</span>
      <a href="#lead">Напишите — поможем <Icon name="arrow-right" size={14} /></a>
    </div>
  </div>
</section>

<style>
  .pricing__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    align-items: stretch;
  }

  .pricing__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }

  .pricing__guarantee {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.4;
  }

  .pricing__guarantee-icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--accent-ink);
  }

  .pricing__guarantee strong {
    color: var(--text);
    font-weight: 600;
  }

  .pricing__payment {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .pricing__help {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 22px;
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pricing__help a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--accent-ink);
    font-weight: 700;
  }

  .pricing__help a:hover {
    color: var(--text);
  }

  @media (max-width: 1023px) {
    .pricing__grid {
      grid-template-columns: 1fr;
      max-width: 620px;
      margin-inline: auto;
    }
  }

  @media (max-width: 767px) {
    .pricing__footer {
      display: grid;
    }

    .pricing__help {
      flex-wrap: wrap;
      text-align: center;
    }
  }
</style>
