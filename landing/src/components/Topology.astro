---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div class:list={["topology", compact && "topology--compact"]} aria-label="Схема маршрутизации сообщений RabbitMQ" role="img">
  <svg viewBox="0 0 760 250" width="100%" fill="none">
    <defs>
      <marker id="topology-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#3b3632" />
      </marker>
      <marker id="topology-arrow-accent" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#ff5533" />
      </marker>
      <path id="topology-flight" d="M 104 115 L 184 115 L 330 115 L 380 41 L 584 41" />
    </defs>

    <g class="topology__grid" stroke="#3b3632" stroke-width="1">
      <path d="M 0 20 H 760 M 0 70 H 760 M 0 120 H 760 M 0 170 H 760 M 0 220 H 760" opacity="0.28" />
      <path d="M 80 0 V 230 M 240 0 V 230 M 400 0 V 230 M 560 0 V 230 M 720 0 V 230" opacity="0.16" />
    </g>

    <g class="topology__links" stroke="#3b3632" stroke-width="1.2" marker-end="url(#topology-arrow)">
      <path d="M 104 115 H 184" />
      <path d="M 288 115 C 330 115 330 41 380 41" />
      <path d="M 288 115 C 330 115 330 111 380 111" />
      <path d="M 288 115 C 330 115 330 181 380 181" stroke="#ff5533" stroke-dasharray="4 4" marker-end="url(#topology-arrow-accent)" />
      <path d="M 482 41 H 584" />
      <path d="M 482 111 H 584" />
      <path d="M 482 181 H 584" stroke="#ff5533" stroke-dasharray="4 4" marker-end="url(#topology-arrow-accent)" />
    </g>

    <g class="topology__nodes" font-family="'JetBrains Mono', Consolas, monospace" font-size="8.5" text-anchor="middle" dominant-baseline="middle">
      <g>
        <rect x="20" y="94" width="84" height="42" rx="7" fill="#211f1d" stroke="#3b3632" />
        <circle cx="25" cy="99" r="2.5" fill="#ff5533" />
        <text x="62" y="115" fill="#f6f2ed">producer</text>
      </g>

      <g>
        <rect x="184" y="94" width="104" height="42" rx="7" fill="#2a201d" stroke="#ff5533" />
        <circle cx="189" cy="99" r="2.5" fill="#ff5533" />
        <text x="236" y="110" fill="#f6f2ed">orders.events</text>
        <text x="236" y="122" fill="#ff9d88" font-size="7.5">topic exchange</text>
      </g>

      <g>
        <rect x="380" y="20" width="102" height="42" rx="7" fill="#211f1d" stroke="#3b3632" />
        <text x="431" y="35" fill="#f6f2ed">orders.email</text>
        <text x="431" y="47" fill="#a9a19a" font-size="7.5">quorum</text>
      </g>
      <g>
        <rect x="380" y="90" width="102" height="42" rx="7" fill="#211f1d" stroke="#3b3632" />
        <text x="431" y="105" fill="#f6f2ed">orders.audit</text>
        <text x="431" y="117" fill="#a9a19a" font-size="7.5">fanout</text>
      </g>
      <g>
        <rect x="380" y="160" width="102" height="42" rx="7" fill="#2d1f1b" stroke="#ff5533" />
        <text x="431" y="175" fill="#ff9d88">dead.letters</text>
        <text x="431" y="187" fill="#ff5533" font-size="7.5">DLQ</text>
      </g>

      <g>
        <rect x="584" y="20" width="92" height="42" rx="7" fill="#211f1d" stroke="#3b3632" />
        <text x="630" y="35" fill="#f6f2ed">consumer 01</text>
        <text x="630" y="47" fill="#a9d18e" font-size="7.5">ack</text>
      </g>
      <g>
        <rect x="584" y="90" width="92" height="42" rx="7" fill="#211f1d" stroke="#3b3632" />
        <text x="630" y="105" fill="#f6f2ed">consumer 02</text>
        <text x="630" y="117" fill="#a9d18e" font-size="7.5">ack</text>
      </g>
      <g>
        <rect x="584" y="160" width="92" height="42" rx="7" fill="#2d1f1b" stroke="#ff5533" />
        <text x="630" y="175" fill="#ff9d88">retry / DLQ</text>
        <text x="630" y="187" fill="#ff5533" font-size="7.5">manual</text>
      </g>
    </g>

    <g class="topology__flight">
      <circle r="3.6" fill="#ff5533">
        <animateMotion dur="4.5s" repeatCount="indefinite" rotate="auto">
          <mpath href="#topology-flight" />
        </animateMotion>
      </circle>
      <circle r="7" fill="none" stroke="#ff5533" opacity="0.24">
        <animateMotion dur="4.5s" repeatCount="indefinite" rotate="auto">
          <mpath href="#topology-flight" />
        </animateMotion>
      </circle>
    </g>

    <g class="topology__labels" font-family="'JetBrains Mono', Consolas, monospace" font-size="7.5" fill="#8a837c">
      <text x="20" y="72">01 / PUBLISH</text>
      <text x="184" y="72">02 / ROUTE</text>
      <text x="380" y="234">03 / CONSUME</text>
      <text x="604" y="234">04 / OBSERVE</text>
    </g>
  </svg>
</div>

<style>
  .topology {
    overflow-x: auto;
    padding: 18px;
    border: 1px solid var(--terminal-border);
    border-radius: var(--radius);
    background:
      linear-gradient(180deg, rgba(255, 85, 51, 0.05), transparent 40%),
      var(--terminal);
    overscroll-behavior-x: contain;
    scrollbar-color: var(--terminal-border) transparent;
    scrollbar-width: thin;
  }

  .topology::-webkit-scrollbar {
    height: 6px;
  }

  .topology::-webkit-scrollbar-thumb {
    border-radius: 1px;
    background: var(--terminal-border);
  }

  .topology svg {
    min-width: 520px;
  }

  .topology--compact {
    padding: 10px;
  }

  .topology--compact svg {
    min-width: 0;
  }

  @media (max-width: 767px) {
    .topology {
      padding: 10px;
    }

    .topology svg {
      min-width: 560px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .topology__flight {
      display: none;
    }
  }
</style>
