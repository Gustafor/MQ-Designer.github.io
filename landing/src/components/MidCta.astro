---
import Button from "./Button.astro";
import Icon from "./Icon.astro";
---

<section class="mid-cta" aria-label="Получить программу">
  <div class="container mid-cta__inner">
    <div class="mid-cta__copy">
      <span class="mid-cta__icon"><Icon name="book" size={20} /></span>
      <div>
        <span class="eyebrow">Не готовы выбрать тариф?</span>
        <p>Пришлём PDF-программу, чек-лист топологии и запись разбора первого кейса.</p>
      </div>
    </div>
    <Button href="#lead" variant="primary" icon>Получить программу</Button>
  </div>
</section>

<style>
  .mid-cta {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .mid-cta__inner {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 108px;
    padding-top: 18px;
    padding-bottom: 18px;
  }

  .mid-cta__copy {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
  }

  .mid-cta__icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255, 85, 51, 0.32);
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--accent-ink);
  }

  .mid-cta__copy div {
    display: grid;
    gap: 5px;
  }

  .mid-cta__copy :global(.eyebrow) {
    font-size: 9px;
  }

  .mid-cta__copy p {
    color: var(--text);
    font-size: 14px;
    line-height: 1.4;
  }

  .mid-cta :global(.btn) {
    flex: 0 0 auto;
    margin-left: auto;
  }

  @media (max-width: 767px) {
    .mid-cta__inner {
      display: grid;
      gap: 16px;
      padding: 18px 0;
    }

    .mid-cta__icon {
      display: none;
    }

    .mid-cta :global(.btn) {
      width: 100%;
      margin-left: 0;
    }
  }
</style>
