---
import Subpage from "../layouts/Subpage.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
---

<Subpage
  title="Заявка принята"
  kicker="Спасибо"
  heading="Заявка принята. Проверьте почту"
  lead="В прототипе данные не отправляются — это демонстрационный экран. В финале здесь будет инструкция: письмо с программой и ссылка на Telegram-бота."
>
  <section class="section">
    <div class="container thanks__grid">
      <div class="thanks__card">
        <span class="thanks__icon"><Icon name="check" size={28} /></span>
        <h2 class="h3">Что дальше</h2>
        <ol class="thanks__steps">
          <li><span class="mono">01</span><span>Письмо с PDF-программой и чек-листом — в течение 5 минут.</span></li>
          <li><span class="mono">02</span><span>Короткий разбор первого кейса — в Telegram-боте.</span></li>
          <li><span class="mono">03</span><span>Если нужно, созвон на 15 минут и выбор тарифа.</span></li>
        </ol>
      </div>
      <div class="thanks__aside">
        <p class="mono">Пока ждёте</p>
        <h3 class="h2">Посмотрите, как работает среда</h3>
        <p>Откройте RabbitMQ Designer и соберите первую схему. Это займёт 3 минуты.</p>
        <Button href="https://gustafor.github.io/MQ-Designer.github.io/" icon>Открыть среду</Button>
        <a href="/">Вернуться на главную <Icon name="arrow-right" size={14} /></a>
      </div>
    </div>
  </section>
</Subpage>

<style>
  .thanks__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: 16px;
  }

  .thanks__card,
  .thanks__aside {
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .thanks__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--accent-ink);
  }

  .thanks__card h2 {
    margin-top: 20px;
  }

  .thanks__steps {
    display: grid;
    gap: 14px;
    margin-top: 22px;
  }

  .thanks__steps li {
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 10px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 14px;
    line-height: 1.45;
  }

  .thanks__steps .mono {
    color: var(--accent-ink);
    font-size: 10px;
  }

  .thanks__aside {
    background: var(--bg-deep);
  }

  .thanks__aside > .mono {
    color: var(--accent-ink);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .thanks__aside h3 {
    margin-top: 14px;
  }

  .thanks__aside > p {
    margin: 14px 0 22px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .thanks__aside > a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 18px;
    color: var(--accent-ink);
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .thanks__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
