---
import Subpage from "../layouts/Subpage.astro";
import Icon from "../components/Icon.astro";
import LeadForm from "../components/LeadForm.astro";
import Topology from "../components/Topology.astro";
import Badge from "../components/Badge.astro";
---

<Subpage
  title="Бесплатные материалы"
  kicker="Free / чек-лист"
  heading="24 вопроса, которые стоит задать до ревью топологии"
  lead="Бесплатный чек-лист для Java/Spring-команд: routing, ack, DLQ, retry, quorum и эксплуатация. Без регистрации в LMS."
>
  <section class="section">
    <div class="container free__grid">
      <div>
        <span class="eyebrow">Что внутри</span>
        <h2 class="h2">Проверьте схему до того, как она попадёт в прод</h2>
        <ul class="free__list">
          <li><Icon name="check" size={15} /><span><strong>Маршрутизация</strong> — все ли bindings ведут туда, куда вы думаете</span></li>
          <li><Icon name="check" size={15} /><span><strong>Надёжность</strong> — ack, confirms, requeue, TTL и dead-letter</span></li>
          <li><Icon name="check" size={15} /><span><strong>Нагрузка</strong> — prefetch, concurrency, quorum и лимиты</span></li>
          <li><Icon name="check" size={15} /><span><strong>Эксплуатация</strong> — метрики, алерты, runbook и инциденты</span></li>
        </ul>
        <div class="free__meta">
          <Badge variant="accent">PDF + Notion</Badge>
          <Badge variant="muted">Без воды</Badge>
          <Badge variant="muted">RU</Badge>
        </div>
        <div class="free__preview">
          <Topology compact />
        </div>
      </div>

      <aside class="free__form">
        <span class="mono">free / checklist</span>
        <h3>Забрать чек-лист</h3>
        <p>Пришлём PDF и короткое письмо с разбором трёх самых частых ошибок. Без спама.</p>
        <LeadForm
          ctaLabel="Получить чек-лист"
          note="Прототип: данные не отправляются. В финале — email-сценарий."
        />
      </aside>
    </div>
  </section>
</Subpage>

<style>
  .free__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(36px, 6vw, 80px);
    align-items: start;
  }

  .free__grid > * {
    min-width: 0;
  }

  .free__list {
    display: grid;
    gap: 12px;
    margin-top: 26px;
    font-size: 14px;
    line-height: 1.45;
  }

  .free__list li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    color: var(--muted);
  }

  .free__list svg {
    flex: 0 0 auto;
    margin-top: 2px;
    color: var(--accent-ink);
  }

  .free__list strong {
    color: var(--text);
    font-weight: 600;
  }

  .free__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 24px;
  }

  .free__preview {
    margin-top: 26px;
  }

  .free__form {
    padding: 24px;
    border: 1px solid var(--text);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: 7px 7px 0 var(--border);
  }

  .free__form > .mono {
    color: var(--accent-ink);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .free__form h3 {
    margin-top: 10px;
    font-size: 26px;
    letter-spacing: -0.02em;
  }

  .free__form > p {
    margin: 8px 0 20px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
  }

  .free__form :global(.lead-form) {
    padding: 0;
    border: 0;
    background: transparent;
  }

  @media (max-width: 900px) {
    .free__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
