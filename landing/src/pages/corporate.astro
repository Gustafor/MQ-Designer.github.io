---
import Subpage from "../layouts/Subpage.astro";
import Icon from "../components/Icon.astro";
import LeadForm from "../components/LeadForm.astro";
import Badge from "../components/Badge.astro";
---

<Subpage
  title="Для компаний"
  kicker="Корпоративный формат"
  heading="Один стандарт проектирования очередей для всей команды"
  lead="Адаптируем программу под ваш стек, проводим в закрытом контуре и разбираем реальные топологии. Счёт, договор и закрывающие документы."
>
  <section class="section">
    <div class="container corporate__grid">
      <div>
        <span class="eyebrow">Что внутри</span>
        <h2 class="h2">Не лекция для галочки, а разбор ваших схем</h2>
        <ul class="corporate__list">
          <li><Icon name="check" size={15} /><span><strong>Аудит текущих топологий</strong> — до старта собираем вопросы и схемы</span></li>
          <li><Icon name="check" size={15} /><span><strong>Адаптация программы</strong> — Spring AMQP, ваш брокер, ваши ограничения</span></li>
          <li><Icon name="check" size={15} /><span><strong>Практика на ваших кейсах</strong> — заказы, платежи, нотификации</span></li>
          <li><Icon name="check" size={15} /><span><strong>Отчёт руководителю</strong> — прогресс, артефакты и рекомендации</span></li>
        </ul>
        <div class="corporate__meta">
          <Badge variant="accent">5–10 человек</Badge>
          <Badge variant="muted">Закрытый контур</Badge>
          <Badge variant="muted">Договор</Badge>
        </div>
      </div>

      <aside class="corporate__card">
        <span class="mono">corporate / format</span>
        <h3>Как это устроено</h3>
        <div class="corporate__fact"><span>Длительность</span><strong>6 недель</strong></div>
        <div class="corporate__fact"><span>Занятия</span><strong>2 × 90 минут в неделю</strong></div>
        <div class="corporate__fact"><span>Практика</span><strong>12 заданий + capstone</strong></div>
        <div class="corporate__fact"><span>Стоимость</span><strong>от 149 000 ₽</strong></div>
        <a class="corporate__link" href="#corporate-lead">Обсудить программу <Icon name="arrow-right" size={15} /></a>
      </aside>
    </div>
  </section>

  <section class="section section--deep" id="corporate-lead">
    <div class="container corporate__lead">
      <div>
        <span class="eyebrow">Заявка</span>
        <h2 class="h2">Соберём программу под вашу команду</h2>
        <p class="lead">Оставьте контакт — вернёмся с вариантами формата, сметой и планом на 6 недель.</p>
        <div class="corporate__contact">
          <Icon name="telegram" size={16} />
          <span>Или напишите в Telegram: <a href="https://t.me/example">@example</a></span>
        </div>
      </div>
      <LeadForm
        ctaLabel="Обсудить команду"
        note="Прототип: данные не отправляются. В финале — CRM и почтовый сценарий."
      />
    </div>
  </section>
</Subpage>

<style>
  .corporate__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(36px, 6vw, 80px);
    align-items: start;
  }

  .corporate__list {
    display: grid;
    gap: 12px;
    margin-top: 26px;
    font-size: 14px;
    line-height: 1.45;
  }

  .corporate__list li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    color: var(--muted);
  }

  .corporate__list svg {
    flex: 0 0 auto;
    margin-top: 2px;
    color: var(--accent-ink);
  }

  .corporate__list strong {
    color: var(--text);
    font-weight: 600;
  }

  .corporate__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 26px;
  }

  .corporate__card {
    padding: 24px;
    border: 1px solid var(--text);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: 7px 7px 0 var(--border);
  }

  .corporate__card > .mono {
    color: var(--accent-ink);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .corporate__card h3 {
    margin: 10px 0 22px;
    font-size: 24px;
    letter-spacing: -0.02em;
  }

  .corporate__fact {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 0;
    border-top: 1px solid var(--border);
    font-size: 12px;
  }

  .corporate__fact span {
    color: var(--muted);
  }

  .corporate__fact strong {
    font-weight: 600;
    text-align: right;
  }

  .corporate__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 20px;
    color: var(--accent-ink);
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .corporate__lead {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }

  .corporate__contact {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    color: var(--muted);
    font-size: 12px;
  }

  .corporate__contact svg {
    color: var(--accent-ink);
  }

  .corporate__contact a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    .corporate__grid,
    .corporate__lead {
      grid-template-columns: 1fr;
    }
  }
</style>
